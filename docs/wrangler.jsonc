// Cloudflare Pages project for the docs site. It sits here so wrangler, run
// from docs/, finds this file and never the app's ../wrangler.jsonc. Pages
// config cannot pin an account: scripts/ship.mjs sets it for each deploy.
{
  "name": "zapiszprzepis-docs",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-10-01"
}
