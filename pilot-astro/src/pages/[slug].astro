---
// Throwaway pilot: the production recipe layout as static HTML, with the interactive parts
// hydrated as islands. Static: RecipeHeader, PageContainer, SiteFooter. Islands: AppHeader,
// RecipeActions, RecipeChecklists, RecipeListNav, SimilarBlock. Production CSS and image route.
// Left out: dish versions, gallery teaser, analytics, and the signed-in overlay.
import { AppHeader } from '@/app/components/app-header'
import { SiteFooter } from '@/app/components/site-footer'
import { PageContainer } from '@/app/components/page-container'
import { RecipeActions } from '@/app/przepis/[slug]/_components/recipe-actions'
import { RecipeHeader, RecipeBreadcrumbs } from '@/app/przepis/[slug]/_components/recipe-header'
import { RecipeChecklists } from '@/app/przepis/[slug]/_components/recipe-checklists'
import { RecipeListNav } from '@/app/przepis/[slug]/_components/recipe-list-bar'
import { RECIPE_MAIN, RECIPE_TOP_ROW } from '@/app/przepis/[slug]/_components/recipe-split'
import { loadCategoryContext } from '@/app/przepis/[slug]/category-context'
import { parseIngredients, groupBySection } from '@/lib/ingredients'
import { parseSteps } from '@/lib/steps'
import { findGlossaryTerms } from '@/lib/ingredient-glossary'
import { coverImageSrc } from '@/lib/recipe-image-archive'
import { SimilarBlock } from '../components/SimilarBlock'
import { imageSrcSet } from '../shims/next-image'

const SUPABASE = 'https://wvrlgddgdddwmgzbvtij.supabase.co'
const KEY = 'sb_publishable_49CjHG7pAqYIFe7roJDZdA_5c_jBzj2'
const SITE = 'https://zapiszprzepis.pl'
const CSS = `${SITE}/_next/static/chunks/2rvoqduuttn3s.css`
const headers = { apikey: KEY, 'content-type': 'application/json' }

export async function getStaticPaths() {
  const slugs = ['zupa-pomidorowa', 'zapiekanka', 'barszcz-ukrainski-5', 'kajzerki']
  return slugs.map((slug) => ({ params: { slug } }))
}

const read = async (query) => (await fetch(`${SUPABASE}/rest/v1/public_recipes?${query}`, { headers })).json()

const { slug } = Astro.params
globalThis.__pilotPath = `/przepis/${slug}`
const [recipe] = await read(`slug=eq.${slug}&select=*&order=created_at.asc&limit=1`)
const cards = await read(`category=eq.${recipe.category}&id=neq.${recipe.id}&select=id,slug,title,image_url,category,description,source_type,source_url,source_author&order=created_at.desc&limit=4`)
const rpc = async (name, body) => {
  const res = await fetch(`${SUPABASE}/rest/v1/rpc/${name}`, { method: 'POST', headers, body: JSON.stringify(body) })
  return { data: res.ok ? await res.json() : null, error: res.ok ? null : { message: String(res.status) } }
}
const categoryContext = await loadCategoryContext({ rpc }, recipe)

const ingredientGroups = groupBySection(parseIngredients(recipe.ingredients))
const steps = parseSteps(recipe.steps)
const glossary = findGlossaryTerms([recipe.title, ...ingredientGroups.flatMap((g) => g.items.map((i) => i.name)), ...steps])
const cover = coverImageSrc(recipe.image_url)
const sizes = '(max-width: 1023px) 100vw, (max-width: 1535px) 40vw, 45vw'
---

<html lang="pl" class="h-full antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5, interactive-widget=resizes-content" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#c2410c" />
    <title>{recipe.title} · Zapisz Przepis</title>
    <link rel="stylesheet" href={CSS} />
    {cover && <link rel="preload" as="image" imagesrcset={imageSrcSet(cover)} imagesizes={sizes} fetchpriority="high" />}
  </head>
  <body class="min-h-full flex flex-col w-full">
    <AppHeader client:load failedShares={{ status: 'ok', shares: [], unreadReady: 0 }} isAuthenticated={false} />
    <main class={RECIPE_MAIN}>
      <PageContainer>
        <div class={`${RECIPE_TOP_ROW} print:hidden`}>
          <RecipeBreadcrumbs category={recipe.category} title={recipe.title} className="hidden lg:ml-auto lg:block" />
        </div>
        <RecipeHeader recipe={recipe}>
          <Fragment slot="actions">
            <RecipeActions
              client:load
              recipeId={recipe.id}
              recipeSlug={recipe.slug}
              isFavorite={false}
              isAuthenticated={false}
              title={recipe.title}
              shareUrl={`${SITE}/przepis/${recipe.slug}`}
              steps={steps}
              stepImages={[]}
            />
          </Fragment>
        </RecipeHeader>
        <RecipeChecklists
          client:visible
          recipeId={recipe.id}
          recipeSlug={recipe.slug}
          recipeTitle={recipe.title}
          ingredientGroups={ingredientGroups}
          steps={steps}
          stepImages={[]}
          servings={recipe.servings}
          glossary={glossary}
        />
        <div class="print:hidden">
          <RecipeListNav client:visible slug={recipe.slug} from={null} fallback={categoryContext} />
          <SimilarBlock client:visible category={recipe.category} tags={recipe.tags ?? []} cards={cards} />
        </div>
      </PageContainer>
    </main>
    <SiteFooter />
  </body>
</html>
