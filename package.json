{
  "name": "bootstrap-scaffold",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "env:link": "node scripts/link-env.mjs",
    "check:auth": "node --env-file=.env.local --import tsx scripts/check-auth.ts",
    "refresh:recipe-times": "node --env-file=.env.local --import tsx scripts/refresh-recipe-times.ts",
    "archive:recipe-images": "node --env-file=.env.local --import tsx scripts/archive-recipe-images.ts",
    "backfill:recipe-tags": "node --env-file=.env.local --import tsx scripts/backfill-recipe-tags.ts",
    "generate:meta-migration": "node --env-file=.env.local --import tsx scripts/generate-meta-description-migration.ts",
    "backfill:source-urls": "node --env-file=.env.local --import tsx scripts/backfill-source-urls.ts",
    "backfill:source-fingerprints": "node --env-file=.env.local --import tsx scripts/backfill-source-fingerprints.ts",
    "backfill:ingredient-fingerprints": "node --env-file=.env.local --import tsx scripts/backfill-ingredient-fingerprints.ts",
    "collapse:duplicate-recipes": "node --env-file=.env.local --import tsx scripts/collapse-duplicate-recipes.ts",
    "collapse:content-duplicates": "node --env-file=.env.local --import tsx scripts/collapse-content-duplicates.ts",
    "fix:recipe-covers": "node --env-file=.env.local --import tsx scripts/fix-recipe-covers.ts",
    "backfill:covers": "node --env-file=.env.local --import tsx scripts/backfill-archive-covers.ts",
    "backfill:source-authors":"node --env-file=.env.local --import tsx scripts/backfill-source-authors.ts",
    "backfill:recipe-servings": "node --env-file=.env.local --import tsx scripts/backfill-recipe-servings.ts",
    "rewrite:recipe-steps": "node --env-file-if-exists=.env.local --import tsx scripts/rewrite-recipe-steps.ts",
    "apply:recipe-fixes": "node --env-file-if-exists=.env.local --import tsx scripts/apply-recipe-fixes.ts",
    "update:recipe-blog-domains": "node --import tsx scripts/update-recipe-blog-domains.ts",
    "smoke:prod": "node --import tsx scripts/smoke-prod-assets.ts",
    "render:banner": "node docs/banner/render.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:reflow": "playwright test --project=reflow --project=phone --reporter=list"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.115.0",
    "inngest": "^4.20.0",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "next-pwa": "^5.6.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitest/ui": "^4.1.8",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "supabase": "^2.116.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8",
    "wrangler": "^4.129.0"
  }
}
