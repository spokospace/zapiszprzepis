# Workers Static Assets. Build output under /_next/static has a content hash in its
# name, so a file never changes; the default is max-age=0, must-revalidate.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Recipes served as static files. The Worker does not run for them, so its middleware cannot
# add these. src/lib/public-headers.test.ts keeps them equal to securityHeaders().
/przepis/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data: blob: https:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' https://wvrlgddgdddwmgzbvtij.supabase.co wss://wvrlgddgdddwmgzbvtij.supabase.co; frame-src https://www.youtube-nocookie.com
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=63072000; includeSubDomains
